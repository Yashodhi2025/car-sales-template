{
  "framework": "nextjs-static-export",
  "version": 2,
  "arcVersion": "2.2.0",
  "schemaVersion": 2,
  "visualEditing": {
    "contractVersion": 1,
    "mode": "strict",
    "controlOnlyPaths": [
      "__fivoraIntake.additionalBusinessDetails",
      "__fivoraIntake.businessSummary",
      "__fivoraIntake.outputLanguage",
      "__fivoraIntake.referenceWebsiteUrl",
      "__fivoraIntake.tone",
      "common.business.email",
      "common.business.phone",
      "common.business.whatsapp",
      "common.copyright",
      "common.headerCtaLabel",
      "common.logoUrl",
      "common.navLabels.home",
      "common.shortDescription",
      "common.websiteTitle"
    ]
  },
  "siteDataFile": "src/data/site-data.json",
  "outputDirectory": "out",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "basePathEnvVar": "NEXT_PUBLIC_SITE_BASE_PATH",
  "pages": [
    {
      "id": "home",
      "label": "Home",
      "route": "/",
      "required": true
    }
  ],
  "editorSchema": {
    "version": 1,
    "sections": [
      {
        "id": "common",
        "path": "common",
        "type": "object",
        "label": "Shared Website Content",
        "fields": [
          {
            "key": "websiteTitle",
            "type": "text",
            "label": "Website Title",
            "required": true
          },
          {
            "key": "shortDescription",
            "type": "textarea",
            "label": "Short Description"
          },
          {
            "key": "logoUrl",
            "type": "image",
            "label": "Website Logo"
          },
          {
            "key": "headerCtaLabel",
            "type": "text",
            "label": "Header Button Label"
          },
          {
            "key": "navLabels",
            "type": "object",
            "label": "Navigation Labels",
            "fields": [
              {
                "key": "home",
                "type": "text",
                "label": "Home Link"
              }
            ]
          },
          {
            "key": "copyright",
            "type": "text",
            "label": "Copyright"
          },
          {
            "key": "business",
            "type": "object",
            "label": "Business",
